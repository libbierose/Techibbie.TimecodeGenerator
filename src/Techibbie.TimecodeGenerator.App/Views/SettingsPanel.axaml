<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Techibbie.TimecodeGenerator.App.Views.SettingsPanel">

  <StackPanel Spacing="14">

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Frame Rate:" VerticalAlignment="Center" Margin="0,0,12,10" />
      <ComboBox x:Name="FpsCombo" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,10" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Audio Device:" VerticalAlignment="Center" Margin="0,0,12,0" />
      <ComboBox x:Name="DeviceCombo" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" />
    </Grid>

    <TextBlock x:Name="FpsHint" TextWrapping="Wrap" FontSize="11"
               Foreground="{StaticResource FaintTextBrush}" />
    <TextBlock x:Name="SampleRateHint" TextWrapping="Wrap" FontSize="11"
               Foreground="{StaticResource WarningTextBrush}" />

    <Border Height="1" Background="{StaticResource DividerBrush}" />

    <CheckBox x:Name="AudioCheck" Content="Enable audio  (click tones when LTC is off)" />
    <CheckBox x:Name="UpdateCheck" Content="Check for updates on startup" />
    <CheckBox x:Name="StartWithWindowsCheck" Content="Start automatically when Windows starts" />

    <Border Height="1" Background="{StaticResource DividerBrush}" />

    <CheckBox x:Name="ObsEnabledCheck" Content="Auto-start LTC when OBS starts streaming/recording" />
    <StackPanel x:Name="ObsFieldsPanel" Spacing="8" Margin="26,0,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="Host:" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox x:Name="ObsHostBox" Grid.Column="1" />
        <TextBlock Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="12,0,8,0" />
        <TextBox x:Name="ObsPortBox" Grid.Column="3" Width="70" />
      </Grid>
      <TextBox x:Name="ObsPasswordBox" Watermark="WebSocket password (blank if auth is off)" PasswordChar="•" />
      <TextBlock Text="In OBS: Tools → WebSocket Server Settings. Enable the server and copy the port/password here."
                 TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FaintTextBrush}" />
    </StackPanel>

    <Border Height="1" Background="{StaticResource DividerBrush}" />

    <CheckBox x:Name="MtcEnabledCheck" Content="Also output MIDI Time Code (MTC)" />
    <StackPanel x:Name="MtcFieldsPanel" Spacing="8" Margin="26,0,0,0">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Text="MIDI Device:" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox x:Name="MtcDeviceCombo" Grid.Column="1" HorizontalAlignment="Stretch" />
      </Grid>
      <TextBlock x:Name="MtcNoDevicesHint" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource WarningTextBrush}" />
      <TextBlock Text="MTC only defines 24/25/30fps rate flags — other frame rates still send correct timecode values, just with the nearest rate flag."
                 TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FaintTextBrush}" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="OkButton" Content="Save" Theme="{StaticResource DialogButton}" IsDefault="True" />
      <Button x:Name="CancelButton" Content="Cancel" Theme="{StaticResource DialogButton}" IsCancel="True" />
    </StackPanel>

  </StackPanel>
</UserControl>
